# Web app: root Compose publishes the app on this host port by default.
AD5_PORT=8090

# Daily reminder schedule and message. The service is opt-in via the Compose profile.
REMINDER_RECIPIENT=you@example.com
REMINDER_FROM=you@example.com
REMINDER_SUBJECT=EPSO AD5 — your daily study loop
REMINDER_TIME=19:00
REMINDER_TIMEZONE=Europe/Paris
REMINDER_APP_URL=http://localhost:8090

# SMTP transport. Use an app-specific password where your provider supports one.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=replace-with-an-app-password
SMTP_TIMEOUT_SECONDS=30
